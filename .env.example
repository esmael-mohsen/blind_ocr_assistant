# Optional online services.
OCR_SPACE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GEMINI_API_KEY=

# Optional local model paths for manual/live setup notes
VOSK_MODEL_EN=models/vosk/vosk-model-small-en-us-0.15
VOSK_MODEL_AR=models/vosk/vosk-model-small-ar-tn-0.1-linto

# Safe local defaults
DEBUG_SAVE_IMAGES=false
SENSITIVE_TEXT_LOGGING=false
LOG_LEVEL=INFO
FRAME_CAPTURE_COUNT=15

# Integrated runtime defaults
ASSISTANT_CAMERA_INDEX=0
ASSISTANT_CAMERA_SOURCE=
ASSISTANT_VOICE_ENABLED=true
ASSISTANT_MICROPHONE_INDEX=
ASSISTANT_RUNTIME_MODE=laptop
ASSISTANT_COMMAND_TIMEOUT_SECONDS=8.0
ASSISTANT_SHOW_WINDOW=true
ASSISTANT_DEFAULT_LANGUAGE=auto
ASSISTANT_AUDIO_CUES_ENABLED=true
ASSISTANT_GUIDED_CAPTURE_ENABLED=true
ASSISTANT_GUIDED_CAPTURE_TIMEOUT_SECONDS=8.0
ASSISTANT_TTS_PROVIDER=auto
ASSISTANT_STT_PROVIDER=auto
ASSISTANT_EDGE_TTS_AR_VOICE=ar-EG-SalmaNeural
ASSISTANT_EDGE_TTS_EN_VOICE=en-US-JennyNeural
ASSISTANT_FRAME_ANALYSIS_INTERVAL_SECONDS=0.35
ASSISTANT_STABLE_TEXT_FRAMES=3
ASSISTANT_TEXT_CONFIDENCE_THRESHOLD=0.55
ASSISTANT_GUIDANCE_COOLDOWN_SECONDS=3.0
ASSISTANT_CAPTURE_OVERRIDE_ENABLED=true
ASSISTANT_QUIET_MODE=false
ASSISTANT_VOICE_REPLY_STYLE=normal
ASSISTANT_WELCOME_LANGUAGE=auto
ASSISTANT_COMMAND_CONFIRM_EXIT=true
ASSISTANT_TERMINAL_LOGS_ENABLED=true
ASSISTANT_VOICE_TRANSCRIPT_LOGS_ENABLED=false

# Gemini-first OCR defaults. Images are sent to Gemini when enabled and online.
ASSISTANT_GEMINI_OCR_ENABLED=true
ASSISTANT_GEMINI_OCR_MODEL=gemini-2.5-flash-lite
ASSISTANT_GEMINI_OCR_TIMEOUT_SECONDS=20
ASSISTANT_GEMINI_OCR_FALLBACK_LOCAL=true
ASSISTANT_GEMINI_TRANSLATION_ENABLED=true
ASSISTANT_GEMINI_TRANSLATION_MODEL=gemini-2.5-flash-lite
ASSISTANT_GEMINI_TRANSLATION_TIMEOUT_SECONDS=20
